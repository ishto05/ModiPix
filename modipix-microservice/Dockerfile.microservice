# Dockerfile.microservice
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*

# 🟢 Copy requirements (it's at root of modipix-microservice, not in src)
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# 🟢 Copy entire service source (you don't need to COPY src, just COPY .)
COPY . .

EXPOSE 8000

CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8000"]
